<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>

<Pane maxHeight="-Infinity"
      maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
      prefHeight="700.0" prefWidth="1300.0" stylesheets="@css/main.css"
      xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.zhuofan.validator.javafx.controller.MainController"
>
   <TabPane layoutX="-1.0" prefHeight="700.0" prefWidth="1300.0" tabClosingPolicy="UNAVAILABLE">
       <Tab text="校验文件">
         <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
             <fx:include source="analysis.fxml" fx:id="analysis" />
         </AnchorPane>
       </Tab>
       <Tab text="描述生成">
           <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="175.0" prefWidth="619.0">
                   <fx:include source="build.fxml" fx:id="build" />
           </AnchorPane>
       </Tab>
       <Tab text="站点设备">
           <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="175.0" prefWidth="619.0">
               <fx:include source="deviceList.fxml" fx:id="deviceList" />
           </AnchorPane>
       </Tab>
       <Tab text="信号模板">
           <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="175.0" prefWidth="619.0">
               <fx:include source="signalTemplate.fxml" fx:id="signalList" />
           </AnchorPane>
       </Tab>
       <Tab text="设备信号">
           <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="175.0" prefWidth="619.0">
               <fx:include source="deviceSignal.fxml" fx:id="deviceSignalList" />
           </AnchorPane>
       </Tab>
   </TabPane>

   <ProgressBar fx:id="progressBar" opacity="0.5" layoutX="450.0" layoutY="440.0" prefWidth="400.0" progress="0.0" visible="false" />

</Pane>
